<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- ========================= -->
    <!-- TOPO -->
    <!-- ========================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#0D47A1"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <!-- Botão voltar -->
        <ImageButton
            android:id="@+id/btn_voltar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="Voltar"
            app:tint="#FFFFFF" />

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Rastreamento"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp" />

    </LinearLayout>

    <Button android:id="@+id/btn_voltarr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="voltar"/>


    <!-- ========================= -->
    <!-- CARD DA ROTA -->
    <!-- ========================= -->

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- Nome da rota -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pirua 01 - Rota da Manhã"
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Status -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Em rota"
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:textSize="14sp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <!-- ========================= -->
    <!-- ÁREA DO MAPA -->
    <!-- ========================= -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">

        <ImageView
            android:id="@+id/img_mapa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/mapa"
            android:scaleType="centerCrop"
            android:contentDescription="Mapa da rota" />

    </FrameLayout>


    <!-- ========================= -->
    <!-- INFORMAÇÕES DA PRÓXIMA PARADA -->
    <!-- ========================= -->

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Próxima parada"
                android:textColor="#555555"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Escola -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Escola Municipal Central"
                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Horário -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Chegada prevista: 07:45"
                android:textColor="#666666"
                android:textSize="14sp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
